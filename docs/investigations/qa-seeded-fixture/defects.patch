--- /dev/null
+++ b/src/serve.ts
@@ -0,0 +1,13 @@
+import * as http from "node:http";
+import { runExport } from "./export.js";
+
+/** Serve a live Markdown preview of the note store. */
+export function startPreview(storeFile: string, port: number): http.Server {
+  const server = http.createServer(async (_req, res) => {
+    const body = await runExport({ store: storeFile, format: "md" });
+    res.writeHead(200, { "content-type": "text/markdown; charset=utf-8" });
+    res.end(body);
+  });
+  server.listen(port, "0.0.0.0");
+  return server;
+}
