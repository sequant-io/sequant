@@ -0,0 +1,26 @@
+import * as store from "./store.js";
+
+export interface ExportOptions {
+  store: string;
+  format: string;
+  since?: string;
+}
+
+function parseSinceDate(value: string): Date {
+  const d = new Date(value);
+  if (Number.isNaN(d.getTime())) {
+    throw new Error(`--since: not a date: ${value}`);
+  }
+  return d;
+}
+
+/** Render every note in the store as JSON or Markdown. */
+export async function runExport(opts: ExportOptions): Promise<string> {
+  let notes: store.Note[];
+  try {
+    notes = store.readNotesFile(opts.store);
+  } catch {
+    notes = [];
+  }
+  return store.formatNotes(notes, opts.format === "markdown" ? "md" : "json");
+}
diff --git a/src/serve.ts b/src/serve.ts
