+import { describe, it, expect } from "vitest";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { assignFreshIds, runImport } from "./import.js";
+
+const note = (id: string, title: string) => ({
+  id,
+  title,
+  body: "b",
+  createdAt: "2026-01-01T00:00:00Z",
+});
+
+describe("notes import", () => {
+  it("gives a colliding note a fresh id", () => {
+    const out = assignFreshIds([note("1", "a")], [note("1", "b"), note("2", "c")]);
+    expect(out[0].id).not.toBe("1");
+    expect(out[1].id).toBe("2");
+  });
+
+  it("imports a notes file", () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "notes-import-"));
+    const storeFile = path.join(dir, "notes.json");
+    const importFile = path.join(dir, "incoming.json");
+    fs.writeFileSync(storeFile, JSON.stringify([note("1", "a")]));
+    fs.writeFileSync(importFile, JSON.stringify([note("1", "a"), note("2", "b")]));
+    runImport(importFile, { store: storeFile, dedupe: true });
+  });
+});
diff --git a/src/import.ts b/src/import.ts
new file mode 100644
index 0000000..e3f4e31
--- /dev/null
+++ b/src/import.ts
@@ -0,0 +1,45 @@
+import * as fs from "node:fs";
+import { randomUUID } from "node:crypto";
+import * as store from "./store.js";
+
+export interface ImportOptions {
+  store: string;
+  dedupe?: boolean;
+  dryrun?: boolean;
+}
+
+/** Parse an import file. Throws unless it is a JSON list of notes. */
+export function parseImportFile(file: string): store.Note[] {
+  const parsed: unknown = JSON.parse(fs.readFileSync(file, "utf-8"));
+  if (!Array.isArray(parsed)) {
+    throw new Error(`${file}: not a list of notes`);
+  }
+  return parsed as store.Note[];
+}
+
+/** Give every incoming note whose id is already taken a fresh id. */
+export function assignFreshIds(
+  existing: store.Note[],
+  incoming: store.Note[],
+): store.Note[] {
+  const taken = new Set(existing.map((n) => n.id));
+  return incoming.map((n) => (taken.has(n.id) ? { ...n, id: randomUUID() } : n));
+}
+
+/** Drop incoming notes whose title and body match a note already stored. */
+function dedupeNotes(
+  existing: store.Note[],
+  incoming: store.Note[],
+): store.Note[] {
+  return incoming;
+}
+
+/** Append the notes in `file` to the store; returns the notes imported. */
+export function runImport(file: string, opts: ImportOptions): store.Note[] {
+  const existing = store.readNotesFile(opts.store);
+  let incoming = parseImportFile(file);
+  if (opts.dedupe) incoming = dedupeNotes(existing, incoming);
+  const merged = [...existing, ...incoming];
+  if (!opts.dryrun) store.writeNotesFile(opts.store, merged);
+  return incoming;
+}
