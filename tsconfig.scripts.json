{
  // Typecheck-only project for `scripts/`.
  //
  // The main `tsconfig.json` includes `src/` and `bin/` only, because those
  // are what `npm run build` emits to `dist/`. `scripts/` is run directly via
  // `npx tsx` and must never be emitted — but "not emitted" had silently come
  // to mean "not typechecked", so nothing in `scripts/` was covered by any
  // gate. Both `scripts/qa/precheck.ts` and the #922 grounding scripts sat
  // outside `tsc` and `eslint` entirely.
  //
  // `allowImportingTsExtensions` is safe here precisely because this project
  // never emits: the scripts import each other with explicit `.ts` specifiers,
  // which is what `tsx` resolves at runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*"],
  // `exclude` REPLACES the inherited list rather than extending it, so the
  // base entries are repeated here verbatim. Dropping them silently pulled
  // `**/*.test.ts` into the project and surfaced three pre-existing errors in
  // `lint-skill-calls.test.ts` — test files are excluded repo-wide by
  // `tsconfig.json` and this project keeps that convention.
  //
  // `scripts/dev/` is gitignored developer scratch (.gitignore:65) with zero
  // tracked files. Absent in CI, so including it makes local and CI
  // typechecks disagree — the same asymmetry that let a lint failure ship
  // green.
  "exclude": [
    "node_modules",
    "dist",
    "templates",
    "**/*.test.ts",
    "**/*.test.tsx",
    "scripts/dev/"
  ]
}
